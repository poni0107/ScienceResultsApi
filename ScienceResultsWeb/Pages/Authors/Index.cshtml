@page
@model ScienceResultsWeb.Pages.Authors.IndexModel

<h2>Authors</h2>

<p><a asp-page="Create">Add Author</a></p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Institution</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Authors)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Institution</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>