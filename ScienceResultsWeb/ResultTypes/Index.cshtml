@page
@model ScienceResultsWeb.Pages.ResultTypes.IndexModel

<h2>Result Types</h2>

<p><a asp-page="Create">Add Result Type</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ResultTypes)
        {
            <tr>
                <td>@item.Name</td>
            </tr>
        }
    </tbody>
</table>